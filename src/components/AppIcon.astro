---
// El icono de cada app (logo/<app>.svg de su repo), en línea: se pinta a la vez que la página, sin
// una petición por icono, y se ve nítido a cualquier tamaño. Todos comparten el fondo morado y
// cambia el dibujo, así que aquí solo va el dibujo.
interface Props {
  slug: string;
  class?: string;
  /** Si el icono dice algo por sí solo; si va junto al nombre de la app, mejor sin etiqueta. */
  label?: string;
}

const glyphs: Record<string, string> = {
  been: '<path d="M50 20 C35 20 27 31 27 43 C27 59 50 79 50 79 C50 79 73 59 73 43 C73 31 65 20 50 20 Z" fill="#FFF6EA"/><circle cx="50" cy="43" r="10" fill="#7A45C4"/>',
  time: '<circle cx="50" cy="50" r="27" fill="none" stroke="#FFF6EA" stroke-width="8"/><path d="M44 38 L63 50 L44 62 Z" fill="#FFF6EA" stroke="#FFF6EA" stroke-width="3" stroke-linejoin="round"/>',
  taste: '<path d="M29 22 L29 37 C29 46 47 46 47 37 L47 22" fill="none" stroke="#FFF6EA" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><line x1="38" y1="22" x2="38" y2="78" stroke="#FFF6EA" stroke-width="7" stroke-linecap="round"/><path d="M59 20 C70 22 73 40 69 53 L59 53 Z" fill="#FFF6EA" stroke="#FFF6EA" stroke-width="3" stroke-linejoin="round"/><line x1="62" y1="50" x2="62" y2="78" stroke="#FFF6EA" stroke-width="7" stroke-linecap="round"/>',
  wallet: '<rect x="20" y="30" width="60" height="40" rx="8" fill="#FFF6EA"/><circle cx="20" cy="50" r="7" fill="#7A45C4"/><circle cx="80" cy="50" r="7" fill="#7A45C4"/><line x1="62" y1="35" x2="62" y2="65" stroke="#7A45C4" stroke-width="3" stroke-linecap="round" stroke-dasharray="3 5"/><rect x="31" y="39" width="9" height="9" rx="2" fill="#7A45C4"/><rect x="43" y="39" width="9" height="9" rx="2" fill="#7A45C4"/><rect x="31" y="52" width="9" height="9" rx="2" fill="#7A45C4"/>',
  count: '<line x1="24" y1="50" x2="46" y2="50" stroke="#FFF6EA" stroke-width="8" stroke-linecap="round"/><line x1="35" y1="39" x2="35" y2="61" stroke="#FFF6EA" stroke-width="8" stroke-linecap="round"/><path d="M58 38 L67 31 L67 69" fill="none" stroke="#FFF6EA" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>',
  sound: '<circle cx="50" cy="50" r="28" fill="#FFF6EA"/><circle cx="50" cy="50" r="19" fill="none" stroke="#7A45C4" stroke-width="2"/><circle cx="50" cy="50" r="9" fill="#7A45C4"/><circle cx="50" cy="50" r="3" fill="#FFF6EA"/>',
  home: '<path d="M50 23 L77 46 L72 46 L72 76 L28 76 L28 46 L23 46 Z" fill="#FFF6EA" stroke="#FFF6EA" stroke-width="6" stroke-linejoin="round"/><rect x="43" y="57" width="14" height="22" rx="4" fill="#7A45C4"/>',
  monster: '<rect x="33" y="20" width="34" height="60" rx="9" fill="#FFF6EA"/><rect x="38" y="16" width="24" height="6" rx="3" fill="#FFF6EA"/><circle cx="43" cy="41" r="4.5" fill="#7A45C4"/><circle cx="57" cy="41" r="4.5" fill="#7A45C4"/><path d="M39 56 L44 62 L50 56 L56 62 L61 56" fill="none" stroke="#7A45C4" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>',
};

const { slug, class: className, label } = Astro.props;
const glyph = glyphs[slug];
// Mejor que la compilación falle a que una app salga sin icono.
if (!glyph) throw new Error(`Falta el icono de la app «${slug}» en AppIcon.astro`);
---

<svg
  class:list={['app-icon', className]}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <rect width="100" height="100" fill="#7A45C4"></rect>
  <Fragment set:html={glyph} />
</svg>
