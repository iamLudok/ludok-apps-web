---
// Privacidad y aviso legal, en el idioma que le pasen. Corta a propósito: la web no recoge nada, y
// lo que sí hacen otros (GitHub al servirla, Ko-fi al cobrar) se dice con su enlace.
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';
import { paths, type Lang } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].privacy;
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} paths={paths.privacy} current="privacy">
  <article class="article">
    <span class="label">{t.kicker}</span>
    <h1>{t.title}</h1>
    <p class="article-desc">{t.lead}</p>
    <div class="prose">
      {
        t.sections.map((section) => (
          <>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
            {section.link && (
              <p>
                <a href={section.link.href}>{section.link.label}</a>
              </p>
            )}
          </>
        ))
      }
    </div>
  </article>
</Base>
